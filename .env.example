APP_NAME=TiendaBase
# Estos dos vienen en seguro a propósito. En tu máquina bajalos a
# APP_ENV=local y APP_DEBUG=true; en el servidor NO los toques. Al revés,
# olvidarse de cambiarlos deja el sitio mostrando rutas de archivos y consultas
# a cualquiera que provoque un error.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://TiendaBase.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# En seguro por defecto, igual que APP_ENV: en tu máquina bajalos a single/debug.
# daily rota por día y borra los viejos solo; con debug el archivo crece sin techo.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=TiendaBase
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Va COMENTADA a propósito. config/session.php la deduce sola: en producción
# queda en true y en local en false. Escribirla acá —aunque sea vacía— pisa esa
# deducción, y la cookie de sesión termina viajando también por http: quien esté
# en la misma red la levanta y entra como ese usuario, incluido el panel.
# Solo descomentala si necesitás forzarla a mano.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En log, los mails NO se mandan: se escriben en storage/logs. Sirve para
# desarrollar, pero en el servidor hay que poner un proveedor real o el link
# para recuperar la contraseña nunca le llega a tu cliente.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
